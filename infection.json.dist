{
    "$schema": "https://raw.githubusercontent.com/infection/infection/refs/heads/master/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ]
    },
    "mutators": {
        "@default": true,
        "UnwrapFinally": false,
        "ReturnRemoval": false,
        "Coalesce": false,
        "GreaterThan": false
    },
    "logs": {
        "text": ".build/infection.log"
    },
    "minMsi": 90,
    "minCoveredMsi": 95,
    "timeout": 60,
    "phpUnit": {
        "configDir": "."
    }
}
